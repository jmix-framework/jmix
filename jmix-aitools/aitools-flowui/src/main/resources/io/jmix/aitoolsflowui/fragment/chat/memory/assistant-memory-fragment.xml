<fragment xmlns="http://jmix.io/schema/flowui/fragment">
    <content>
        <vbox id="root"
              width="100%"
              height="100%"
              padding="false"
              spacing="false"
              classNames="assistant-memory">
            <hbox id="memoryHeader"
                  width="100%"
                  alignItems="CENTER"
                  spacing="false"
                  classNames="assistant-memory-header">
                <h3 id="memoryTitle"
                    text="msg:///assistantMemory.title"
                    classNames="assistant-memory-title"/>
                <button id="memoryCloseBtn"
                        icon="CLOSE"
                        themeNames="tertiary small icon"
                        ariaLabel="msg:///assistantMemory.close">
                    <tooltip text="msg:///assistantMemory.close"/>
                </button>
            </hbox>
            <span id="memoryHint"
                  text="msg:///assistantMemory.hint"
                  classNames="assistant-memory-hint"/>
            <span id="memoryEmpty"
                  text="msg:///assistantMemory.empty"
                  classNames="assistant-memory-empty"/>
            <vbox id="memoryList"
                  width="100%"
                  padding="false"
                  spacing="false"
                  classNames="assistant-memory-list"/>
        </vbox>
    </content>
</fragment>
