<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
    <changeSet author="audit" id="1">
        <preConditions onFail="MARK_RAN">
            <not>
                <or>
                    <indexExists tableName="AUDIT_ENTITY_LOG" columnNames="EVENT_TS"/>
                    <indexExists tableName="AUDIT_ENTITY_LOG" indexName="IDX_AUDIT_ENTITY_LOG_EVENT_TS"/>
                </or>
            </not>
        </preConditions>
        <createIndex tableName="AUDIT_ENTITY_LOG" indexName="IDX_AUDIT_ENTITY_LOG_EVENT_TS">
            <column name="EVENT_TS"/>
        </createIndex>
    </changeSet>

    <changeSet author="audit" id="2">
        <preConditions onFail="MARK_RAN">
            <not>
                <or>
                    <indexExists tableName="AUDIT_ENTITY_LOG" columnNames="ENTITY_ID, EVENT_TS"/>
                    <indexExists tableName="AUDIT_ENTITY_LOG" indexName="IDX_AUDIT_ENTITY_LOG_ENTITY_ID"/>
                </or>
            </not>
        </preConditions>
        <createIndex tableName="AUDIT_ENTITY_LOG" indexName="IDX_AUDIT_ENTITY_LOG_ENTITY_ID">
            <column name="ENTITY_ID"/>
            <column name="EVENT_TS"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
