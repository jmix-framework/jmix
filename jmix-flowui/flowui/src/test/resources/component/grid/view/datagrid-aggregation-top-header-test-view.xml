<view xmlns="http://jmix.io/schema/flowui/view">
    <data>
        <collection id="aggregationTestEntityDc"
                    class="test_support.entity.AggregationTestEntity">
            <loader id="aggregationTestEntityDl">
                <query><![CDATA[select e from test_AggregationTestEntity e]]></query>
            </loader>
        </collection>
        <collection id="groupsDc" class="test_support.entity.sec.Group"/>
    </data>
    <layout>
        <gridColumnVisibility id="columnVisibility" dataGrid="aggregationTopDataGrid"/>
        <dataGrid id="aggregationTopDataGrid" aggregatable="true" aggregationPosition="TOP"
                  dataContainer="aggregationTestEntityDc">
            <columns>
                <column property="name" header="Name header" filterable="true"/>
                <column property="fromDate"/>
                <column property="usages" header="Usages header">
                    <aggregation type="SUM"/>
                </column>
            </columns>
        </dataGrid>
        <gridColumnVisibility id="treeColumnVisibility" dataGrid="aggregationTopTreeDataGrid"/>
        <treeDataGrid id="aggregationTopTreeDataGrid" aggregatable="true" aggregationPosition="TOP"
                      dataContainer="groupsDc" hierarchyProperty="parent">
            <columns>
                <column property="name" header="Group name header">
                    <aggregation type="COUNT"/>
                </column>
            </columns>
        </treeDataGrid>
    </layout>
</view>
