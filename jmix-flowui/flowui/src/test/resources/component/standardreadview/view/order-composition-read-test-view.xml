<view xmlns="http://jmix.io/schema/flowui/view">
    <data>
        <instance id="orderDc"
                  class="test_support.entity.sales.Order">
            <fetchPlan extends="_base">
                <property name="orderLines" fetchPlan="_base"/>
            </fetchPlan>
            <collection id="linesDc" property="orderLines"/>
            <loader id="orderDl"/>
        </instance>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
    </facets>
    <layout>
        <textField id="numberField" dataContainer="orderDc" property="number"/>
        <dataGrid id="linesDataGrid" dataContainer="linesDc" width="100%">
            <actions>
                <action id="read" type="list_read">
                    <properties>
                        <property name="openMode" value="DIALOG"/>
                    </properties>
                </action>
            </actions>
            <columns>
                <column property="description"/>
                <column property="quantity"/>
            </columns>
        </dataGrid>
    </layout>
</view>
