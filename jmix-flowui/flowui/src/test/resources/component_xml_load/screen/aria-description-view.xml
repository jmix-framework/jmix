<view xmlns="http://jmix.io/schema/flowui/view">
    <layout>
        <span id="description" text="Description"/>

        <textField id="textField" ariaDescribedBy="description"/>
        <textArea id="textArea" ariaDescribedBy="description"/>
        <emailField id="emailField" ariaDescribedBy="description"/>
        <passwordField id="passwordField" ariaDescribedBy="description"/>
        <integerField id="integerField" ariaDescribedBy="description"/>
        <numberField id="numberField" ariaDescribedBy="description"/>
        <bigDecimalField id="bigDecimalField" ariaDescribedBy="description"/>
        <datePicker id="datePicker" ariaDescribedBy="description"/>
        <timePicker id="timePicker" ariaDescribedBy="description"/>
        <comboBox id="comboBox" ariaDescribedBy="description"/>
        <entityComboBox id="entityComboBox" metaClass="test_Order" ariaDescribedBy="description"/>
        <multiSelectComboBox id="multiSelectComboBox" ariaDescribedBy="description"/>
        <multiSelectComboBoxPicker id="multiSelectComboBoxPicker" metaClass="test_Order"
                                   ariaDescribedBy="description"/>
        <select id="select" ariaDescribedBy="description"/>
        <checkbox id="checkbox" ariaDescribedBy="description"/>
        <checkboxGroup id="checkboxGroup" ariaDescribedBy="description"/>
        <radioButtonGroup id="radioButtonGroup" ariaDescribedBy="description"/>
        <integerSlider id="integerSlider" ariaDescribedBy="description"/>
        <decimalSlider id="decimalSlider" ariaDescribedBy="description"/>
    </layout>
</view>
