<view xmlns="http://jmix.io/schema/flowui/view">
    <layout>
        <dataGrid id="noI18nDataGrid" metaClass="test_Order">
            <columns>
                <column property="number"/>
            </columns>
        </dataGrid>
        <dataGrid id="emptyI18nDataGrid" metaClass="test_Order">
            <columns>
                <column property="number"/>
            </columns>
            <i18n/>
        </dataGrid>
        <dataGrid id="fullI18nDataGrid" metaClass="test_Order">
            <columns>
                <column property="number"/>
            </columns>
            <i18n selectAll="All rows"
                  selectAllUnavailable="All rows unavailable"
                  selectRow="Row {rowHeader}"
                  sorter="Sort {column}"/>
        </dataGrid>
        <dataGrid id="partialI18nDataGrid" metaClass="test_Order">
            <i18n sorter="msg://partialI18nDataGrid.sorter"/>
            <columns>
                <column property="number"/>
            </columns>
        </dataGrid>
        <treeDataGrid id="i18nTreeDataGrid" metaClass="test_Order" hierarchyProperty="number">
            <columns>
                <column property="number"/>
            </columns>
            <i18n sorter="treeSorter"/>
        </treeDataGrid>
    </layout>
</view>
