<view xmlns="http://jmix.io/schema/flowui/view">
    <layout>
        <button id="targetButton" text="Target"/>

        <popover id="popover"
                 ariaLabel="ariaLabel"
                 ariaLabelledBy="ariaLabelledBy"
                 autofocus="true"
                 backdropVisible="true"
                 classNames="className1, className2"
                 closeOnEsc="false"
                 closeOnOutsideClick="false"
                 enabled="false"
                 focusDelay="100"
                 height="200px"
                 hideDelay="300"
                 hoverDelay="200"
                 modal="true"
                 openOnClick="false"
                 openOnFocus="true"
                 openOnHover="true"
                 position="BOTTOM_END"
                 role="tooltip"
                 tabFocusEnabled="false"
                 target="targetButton"
                 themeNames="arrow no-padding"
                 visible="false"
                 width="300px">
            <vbox id="popoverContentBox" padding="false">
                <h4 text="Title"/>
            </vbox>
            <button id="popoverContentButton" text="Inside"/>
        </popover>

        <popover id="plainPopover"/>
    </layout>
</view>
