<view xmlns="http://jmix.io/schema/flowui/view">
    <layout>
        <integerRangeSlider
                id="integerRangeSliderId"
                accessibleNameStart="accessibleNameStartString"
                accessibleNameEnd="accessibleNameEndString"
                classNames="cssClassName1, cssClassName2"
                css="color: red;"
                enabled="true"
                errorMessage="errorMessageString"
                endValue="80"
                height="50px"
                helperText="helperTextString"
                label="labelString"
                max="100"
                maxHeight="55px"
                maxWidth="120px"
                min="0"
                minHeight="40px"
                minWidth="80px"
                minMaxVisible="true"
                readOnly="true"
                required="true"
                startValue="20"
                step="5"
                tabIndex="3"
                valueAlwaysVisible="true"
                valueChangeMode="ON_CHANGE"
                valueChangeTimeout="50"
                visible="true"
                width="100px">
            <tooltip text="tooltipText"
                     focusDelay="1"
                     hideDelay="2"
                     hoverDelay="3"
                     manual="true"
                     opened="true"
                     position="BOTTOM"
            />
        </integerRangeSlider>

        <decimalRangeSlider
                id="decimalRangeSliderId"
                accessibleNameStart="accessibleNameStartString"
                accessibleNameEnd="accessibleNameEndString"
                classNames="cssClassName1, cssClassName2"
                css="color: red;"
                enabled="true"
                errorMessage="errorMessageString"
                endValue="80.5"
                height="50px"
                helperText="helperTextString"
                label="labelString"
                max="100"
                maxHeight="55px"
                maxWidth="120px"
                min="0"
                minHeight="40px"
                minWidth="80px"
                minMaxVisible="true"
                readOnly="true"
                required="true"
                startValue="20.5"
                step="0.5"
                tabIndex="3"
                valueAlwaysVisible="true"
                valueChangeMode="ON_CHANGE"
                valueChangeTimeout="50"
                visible="true"
                width="100px">
            <tooltip text="tooltipText"
                     focusDelay="1"
                     hideDelay="2"
                     hoverDelay="3"
                     manual="true"
                     opened="true"
                     position="BOTTOM"
            />
        </decimalRangeSlider>

        <integerRangeSlider id="integerRangeSliderWithStartValueId" min="0" max="60" startValue="20"/>

        <decimalRangeSlider id="decimalRangeSliderWithEndValueId" min="0" max="60" endValue="20"/>
    </layout>
</view>
