<view xmlns="http://jmix.io/schema/flowui/view">
    <layout>
        <stepper id="stepperId"
                 orientation="VERTICAL"
                 validationEnabled="false"
                 themeNames="small completed-success"
                 classNames="cssClassName1, cssClassName2"
                 width="30em"
                 height="20em">
            <step id="firstStep" label="First" description="First description" icon="USER">
                <vbox id="firstContent"/>
            </step>
            <step id="hiddenStep" label="Hidden" visible="false">
                <span id="hiddenContent" text="Hidden"/>
            </step>
            <step id="emptyStep" label="Empty"/>
        </stepper>
    </layout>
</view>
