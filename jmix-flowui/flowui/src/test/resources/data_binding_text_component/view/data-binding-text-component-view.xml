<view xmlns="http://jmix.io/schema/flowui/view">
    <data readOnly="true">
        <instance id="zooDc"
                  class="test_support.entity.Zoo">
            <loader id="zooDl">
                <query>
                    <![CDATA[select e from test_Zoo e]]>
                </query>
            </loader>
            <fetchPlan extends="_base">
                <property name="city" fetchPlan="_base"/>
            </fetchPlan>
        </instance>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
    </facets>
    <layout>
        <badge id="nameBadge" dataContainer="zooDc" property="name"/>
        <badge id="cityBadge" dataContainer="zooDc" property="city.name"/>
        <badge id="textBadge" text="Text"/>

        <formLayout dataContainer="zooDc">
            <badge id="formBadge" property="address"/>
        </formLayout>
    </layout>
</view>
