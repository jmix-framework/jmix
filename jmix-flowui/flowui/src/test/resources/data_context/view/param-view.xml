<view xmlns="http://jmix.io/schema/flowui/view">
    <data>
        <instance id="paramDc"
                  class="test_support.entity.sales.OrderLineParam">
            <fetchPlan extends="_base">
                <property name="notes" fetchPlan="_base"/>
            </fetchPlan>
            <loader id="paramDl"/>
            <collection id="notesDc" property="notes"/>
        </instance>
    </data>
    <layout>
        <formLayout id="form" dataContainer="paramDc">
            <textField id="valueField" property="value"/>
        </formLayout>
        <dataGrid id="notesDataGrid" dataContainer="notesDc">
            <columns>
                <column property="text"/>
            </columns>
        </dataGrid>
    </layout>
</view>
