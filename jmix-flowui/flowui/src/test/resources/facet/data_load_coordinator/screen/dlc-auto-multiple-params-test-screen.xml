<view xmlns="http://jmix.io/schema/flowui/view"
        title="Owners">
    <data readOnly="true">
        <collection id="ownersDc"
                    class="test_support.entity.petclinic.Owner">
            <fetchPlan extends="_local">
                <property name="category" fetchPlan="_local"/>
            </fetchPlan>
            <loader id="ownersDl">
                <query>
                    <![CDATA[select e from pc_Owner e
                    where e.name like :component_nameFilterField
                    and e.category = :component_categoryFilterField]]>
                </query>
            </loader>
        </collection>
        <collection id="petsDc" class="test_support.entity.petclinic.Pet">
            <loader id="petsDl">
                <query>
                    <![CDATA[select e from pc_Pet e
                    where e.owner = :container_ownersDc
                    and e.name like :component_petNameFilterField]]>
                </query>
            </loader>
        </collection>
    </data>
    <facets>
        <dataLoadCoordinator id="dlc" auto="true"/>
    </facets>
    <layout>
        <entityPicker id="categoryFilterField" metaClass="pc_OwnerCategory"/>
        <textField id="nameFilterField"/>
        <textField id="petNameFilterField"/>
    </layout>
</view>
