<view xmlns="http://jmix.io/schema/flowui/view">
    <data>
        <collection id="roleModelsDc" class="io.jmix.security.model.ResourceRoleModel"/>
    </data>
    <actions>
        <action id="selectAction" type="lookup_select"/>
        <action id="discardAction" type="lookup_discard"/>
    </actions>
    <layout>
        <dataGrid id="rolesGrid" width="100%" dataContainer="roleModelsDc">
            <columns>
                <column property="name"/>
                <column property="code"/>
            </columns>
        </dataGrid>
    </layout>
</view>
