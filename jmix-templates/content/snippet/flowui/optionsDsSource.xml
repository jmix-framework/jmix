<%
def optionsDatasourceAttrs = api.evaluateScript('optionsDatasources.groovy', ['view': view])
%>
<%if (optionsDatasourceAttrs) {
    optionsDatasourceAttrs.unique { it.entityType.fqn }.each {attr ->
        def containerId = api.pluralForm(attr.entityType.uncapitalizedClassName)%>
        <collection id="${containerId}Dc" class="${attr.entityType.fqn}">
            <loader id="${containerId}Dl" readOnly="true">
                <query>
                    <![CDATA[select e from ${attr.entityType.name} e]]>
                </query>
            </loader>
            <fetchPlan extends="_instance_name"/>
        </collection>
<%}}%>